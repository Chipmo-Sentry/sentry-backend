# sentry-backend — environment variables example
# Copy to .env and fill in real values for local development.
# DO NOT commit .env (already in .gitignore).

# Environment ----------------------------------------------------------
ENVIRONMENT=dev            # dev | staging | production
DEBUG=true                 # SQLAlchemy echo when true
LOG_LEVEL=INFO

# Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Database -------------------------------------------------------------
# asyncpg driver required (NOT psycopg2). For Alembic offline migrations a
# sync URL is auto-derived if needed.
DATABASE_URL=postgresql+asyncpg://sentry:sentry@localhost:5432/sentry_dev
# SQLAlchemy connection pool (per replica). pool_size + max_overflow must stay
# well under the Postgres max_connections (Railway's addon limit is finite) —
# shrink these if the DB starts refusing connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT / Auth -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-real-32-plus-char-secret-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Inter-service auth (sentry-ai → sentry-backend) ----------------------
SERVICE_TOKEN_SECRET=replace-me-with-another-32-plus-char-secret-please
SERVICE_TOKEN_TTL_DAYS=365

# Fernet key for RTSP URL encryption at rest ---------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTSP_FERNET_KEY=replace-with-Fernet-generated-key

# CORS -----------------------------------------------------------------
# Comma-separated origins, e.g. "https://app.sentry.chipmo.mn,https://admin.sentry.chipmo.mn"
# In production an EMPTY value makes the app refuse to start (no open CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth cookie scoping --------------------------------------------------
# For split-subdomain SPAs (app./admin. → api.) set the parent domain and
# SameSite=None so cookies are sent cross-site (None forces Secure/HTTPS).
# Leave blank for same-origin/localhost dev.
#   COOKIE_DOMAIN=.sentry.chipmo.mn
#   COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Storage --------------------------------------------------------------
# Where evidence clip .mp4 files are written.
# ⚠️ RAILWAY (production): the container filesystem is EPHEMERAL — every
# deploy/restart wipes it, destroying ALL evidence clips. You MUST attach a
# Railway Volume to the service (dashboard → service → Volumes, mount path
# e.g. /data) and then set CLIP_STORAGE_DIR=/data/clips. Without this, clips
# silently vanish on the next deploy. Startup logs `clip_storage_ready` /
# `clip_storage_not_writable` so you can verify the mount.
CLIP_STORAGE_DIR=./storage/clips
MAX_CLIP_SIZE_MB=100

# Data retention (T09/T13 — privacy-policy auto-deletion) ----------------
# Background sweep deletes data strictly older than each window. 0 or negative
# disables that cleanup type (keep forever); sweep interval <= 0 disables the
# whole loop. Clip rows referenced by an alert are kept (business history) —
# only their .mp4 file is removed; everything else is deleted file+row.
RETENTION_SWEEP_INTERVAL_SEC=3600
CLIP_RETENTION_DAYS=90
METRIC_RETENTION_DAYS=30
PAIRING_CODE_RETENTION_DAYS=7

# sentry-ai integration ------------------------------------------------
SENTRY_AI_URL=http://localhost:8001

# M1-LIVE live pipeline -------------------------------------------------
# Shared secret accepted by /api/v1/internal/live-metadata. MUST match
# sentry-ai's SENTRY_BACKEND_SERVICE_TOKEN. No hardcoded default — set here.
LIVE_METADATA_SHARED_SECRET=replace-with-shared-secret-matching-sentry-ai
# MediaMTX admin API for dynamic camera path config (None disables sync).
MEDIAMTX_API_URL=http://127.0.0.1:9997
# MediaMTX recordings dir (enables L5 threshold-breach clip cut). None disables.
MEDIAMTX_RECORDINGS_DIR=

# Landing lead capture (LD.1/LD.2) --------------------------------------
# Founder notification for new demo requests. When both set, a new lead
# pings this Telegram chat; otherwise leads are only persisted + logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Per-IP rate limit on the public POST /api/v1/leads endpoint.
LEAD_RATE_LIMIT=5/hour
# Trusted reverse-proxy hops in front of the backend. The rate-limit key reads
# the X-Forwarded-For entry this many positions from the right (the IP the
# trusted proxy appended), so forged left-most XFF entries can't mint fresh
# buckets. Railway edge = 1. Use 0 if exposed directly with no proxy.
TRUSTED_PROXY_HOPS=1

# Alert notifications (BE1) ---------------------------------------------
# A store's own telegram_chat_id wins; this is the global fallback chat for
# actionable alerts (notify/review). Reuses TELEGRAM_BOT_TOKEN above.
TELEGRAM_ALERT_CHAT_ID=

# AI node offline watchdog (T12) -----------------------------------------
# Background loop pings the founder's Telegram (TELEGRAM_BOT_TOKEN +
# TELEGRAM_CHAT_ID above) when an active AI node stops heartbeating, and again
# when it comes back online. Check interval in seconds; <= 0 disables the loop.
NODE_WATCHDOG_INTERVAL_SEC=60
# A node is "offline" after this many seconds without a heartbeat. Keep aligned
# with the admin dashboard's 3-minute online cutoff.
NODE_OFFLINE_AFTER_SEC=180
