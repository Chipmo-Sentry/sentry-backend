# sentry-backend — environment variables example
# Copy to .env and fill in real values for local development.
# DO NOT commit .env (already in .gitignore).

# Environment ----------------------------------------------------------
ENVIRONMENT=dev            # dev | staging | production
DEBUG=true                 # SQLAlchemy echo when true
LOG_LEVEL=INFO

# Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Database -------------------------------------------------------------
# asyncpg driver required (NOT psycopg2). For Alembic offline migrations a
# sync URL is auto-derived if needed.
DATABASE_URL=postgresql+asyncpg://sentry:sentry@localhost:5432/sentry_dev

# JWT / Auth -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-real-32-plus-char-secret-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Inter-service auth (sentry-ai → sentry-backend) ----------------------
SERVICE_TOKEN_SECRET=replace-me-with-another-32-plus-char-secret-please
SERVICE_TOKEN_TTL_DAYS=365

# Fernet key for RTSP URL encryption at rest ---------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTSP_FERNET_KEY=replace-with-Fernet-generated-key

# CORS -----------------------------------------------------------------
# Comma-separated origins, e.g. "https://app.sentry.chipmo.mn,https://admin.sentry.chipmo.mn"
# In production an EMPTY value makes the app refuse to start (no open CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth cookie scoping --------------------------------------------------
# For split-subdomain SPAs (app./admin. → api.) set the parent domain and
# SameSite=None so cookies are sent cross-site (None forces Secure/HTTPS).
# Leave blank for same-origin/localhost dev.
#   COOKIE_DOMAIN=.sentry.chipmo.mn
#   COOKIE_SAMESITE=none
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Storage --------------------------------------------------------------
CLIP_STORAGE_DIR=./storage/clips
MAX_CLIP_SIZE_MB=100

# sentry-ai integration ------------------------------------------------
SENTRY_AI_URL=http://localhost:8001

# M1-LIVE live pipeline -------------------------------------------------
# Shared secret accepted by /api/v1/internal/live-metadata. MUST match
# sentry-ai's SENTRY_BACKEND_SERVICE_TOKEN. No hardcoded default — set here.
LIVE_METADATA_SHARED_SECRET=replace-with-shared-secret-matching-sentry-ai
# MediaMTX admin API for dynamic camera path config (None disables sync).
MEDIAMTX_API_URL=http://127.0.0.1:9997
# MediaMTX recordings dir (enables L5 threshold-breach clip cut). None disables.
MEDIAMTX_RECORDINGS_DIR=

# Landing lead capture (LD.1/LD.2) --------------------------------------
# Founder notification for new demo requests. When both set, a new lead
# pings this Telegram chat; otherwise leads are only persisted + logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Per-IP rate limit on the public POST /api/v1/leads endpoint.
LEAD_RATE_LIMIT=5/hour

# Alert notifications (BE1) ---------------------------------------------
# A store's own telegram_chat_id wins; this is the global fallback chat for
# actionable alerts (notify/review). Reuses TELEGRAM_BOT_TOKEN above.
TELEGRAM_ALERT_CHAT_ID=
