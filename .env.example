# sentry-backend — environment variables example
# Copy to .env and fill in real values for local development.
# DO NOT commit .env (already in .gitignore).

# Environment ----------------------------------------------------------
ENVIRONMENT=dev            # dev | staging | production
DEBUG=true                 # SQLAlchemy echo when true
LOG_LEVEL=INFO

# Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Database -------------------------------------------------------------
# asyncpg driver required (NOT psycopg2). For Alembic offline migrations a
# sync URL is auto-derived if needed.
DATABASE_URL=postgresql+asyncpg://sentry:sentry@localhost:5432/sentry_dev

# JWT / Auth -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-real-32-plus-char-secret-please
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Inter-service auth (sentry-ai → sentry-backend) ----------------------
SERVICE_TOKEN_SECRET=replace-me-with-another-32-plus-char-secret-please
SERVICE_TOKEN_TTL_DAYS=365

# Fernet key for RTSP URL encryption at rest ---------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTSP_FERNET_KEY=replace-with-Fernet-generated-key

# CORS -----------------------------------------------------------------
# Comma-separated origins, e.g. "https://app.sentry.chipmo.mn,https://admin.sentry.chipmo.mn"
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage --------------------------------------------------------------
CLIP_STORAGE_DIR=./storage/clips
MAX_CLIP_SIZE_MB=100
