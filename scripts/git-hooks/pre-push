#!/bin/sh
# Pre-push gate — mirrors the CI "Lint + type-check" steps so an unformatted or
# type-broken commit never reaches main (CI was red for days because pushes
# skipped these checks locally).
#
# One-time setup per clone:
#   git config core.hooksPath scripts/git-hooks
#
# Bypass (emergencies only):  git push --no-verify

set -e

# Graceful skip when uv isn't on PATH (e.g. GUI git clients / bare shells).
# Running the tools via the global python instead would die with
# "ModuleNotFoundError: sentry_backend" — never call them without `uv run`.
# CI runs the exact same checks, so skipping locally is safe (just noisier).
if ! command -v uv >/dev/null 2>&1; then
  echo "[pre-push] ⚠ uv not found on PATH — skipping local checks (CI runs the same gate)"
  exit 0
fi

echo "[pre-push] ruff format --check ."
uv run ruff format --check . || {
  echo ""
  echo "[pre-push] ❌ Unformatted files. Fix with:  uv run ruff format ."
  exit 1
}

echo "[pre-push] ruff check ."
uv run ruff check . || {
  echo ""
  echo "[pre-push] ❌ Lint errors. Many auto-fix with:  uv run ruff check --fix ."
  exit 1
}

echo "[pre-push] mypy src/sentry_backend"
uv run mypy src/sentry_backend || {
  echo ""
  echo "[pre-push] ❌ Type errors — fix before pushing (CI runs the same check)."
  exit 1
}

echo "[pre-push] ✅ all checks passed"
